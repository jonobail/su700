# SU700 YouTube helper settings. Copy to .env and fill in (docker run --env-file server/.env ...).
# Required in production (NODE_ENV=production): TOKEN_SECRET, TURNSTILE_SECRET, ALLOWED_ORIGINS.
# Outside production they may be left unset: a random TOKEN_SECRET, Cloudflare's always-pass
# Turnstile test secret, and "allow any origin" are used instead.

NODE_ENV=production
HOST=0.0.0.0
PORT=3700

# --- Secrets ---
# HMAC key for snippet tokens. Generate with: openssl rand -hex 32
TOKEN_SECRET=
# Cloudflare Turnstile secret key (dash.cloudflare.com → Turnstile → your widget).
TURNSTILE_SECRET=
# Salt for hashing client IPs in tokens and logs (random per process if unset).
IP_HASH_SALT=

# --- Who may call the API (comma-separated origins, no trailing slash) ---
ALLOWED_ORIGINS=https://jonobail.github.io,http://localhost:4200

# --- Client IP detection ---
# Behind a Cloudflare Tunnel / proxy: trust CF-Connecting-IP.
TRUST_CLOUDFLARE=false
# Behind another reverse proxy: trust the first X-Forwarded-For address.
TRUST_PROXY=false

# --- Switches ---
# Kill switch: /api/health reports youtube:false and token/snippet requests are refused.
DISABLE_YOUTUBE=false
# Re-enable the old whole-track endpoints (/api/youtube/info, /api/youtube/audio). Local use only.
ALLOW_FULL_DOWNLOAD=false

# --- Caps ---
MAX_VIDEO_SECONDS=600
MAX_SNIPPET_SECONDS=30
MAX_CONCURRENT=3
SNIPPET_TIMEOUT_MS=60000
TOKEN_TTL_SECONDS=300

# --- Rate limits (rolling windows, in memory) ---
RATE_TOKENS_PER_HOUR=6
RATE_SNIPPET_MINUTES_PER_DAY=30
RATE_GLOBAL_SNIPPETS_PER_DAY=500

# --- Tool locations (defaults: server/bin, then PATH; the Docker image sets these) ---
# YTDLP=/usr/local/bin/yt-dlp
# FFMPEG=/usr/bin/ffmpeg
# DENO=/usr/local/bin/deno
